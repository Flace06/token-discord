# ── Discord Bot ──────────────────────────────────────────────
# Bot Token (Discord Developer Portal → Bot → Token)
BOT_TOKEN=your_bot_token_here

# Application Client ID (Discord Developer Portal → General Information)
CLIENT_ID=your_client_id_here

# Application Client Secret (Discord Developer Portal → OAuth2)
CLIENT_SECRET=your_client_secret_here

# ── Datenbank ─────────────────────────────────────────────────
# MongoDB Atlas Connection String
# Erstelle einen kostenlosen Cluster auf: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/discordbot

# ── Dashboard ─────────────────────────────────────────────────
# Deine öffentliche URL (auf Render: https://dein-bot.onrender.com)
DASHBOARD_URL=http://localhost:3000

# Geheimer Schlüssel für Sessions (beliebiger langer String)
SESSION_SECRET=ein_sehr_geheimer_schluessel_hier

# ── Server-Port ───────────────────────────────────────────────
# Wird von Render automatisch gesetzt, lokal: 3000
PORT=3000
